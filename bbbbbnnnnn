    if imDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - imSP
        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then imMoved = true end
        invisMini.Position = UDim2.new(imSV.X.Scale, imSV.X.Offset + d.X,
                                        imSV.Y.Scale, imSV.Y.Offset + d.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch) and imDrag then
        imDrag = false
        if not imMoved and (tick() - imST) < 1 then
            invisWin.Position = UDim2.new(invisMini.Position.X.Scale, invisMini.Position.X.Offset,
                                           invisMini.Position.Y.Scale, invisMini.Position.Y.Offset)
            invisWin.Visible = true
            invisMini.Visible = false
        end
    end
end)

