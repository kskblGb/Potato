local function bindUp(btn)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            flyUp = true
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            flyUp = false
        end
    end)
    btn.MouseButton1Down:Connect(function() flyUp = true end)
    btn.MouseButton1Up:Connect(function() flyUp = false end)
    btn.MouseLeave:Connect(function() flyUp = false end)
end

local function bindDown(btn)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            flyDown = true
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            flyDown = false
        end
    end)
    btn.MouseButton1Down:Connect(function() flyDown = true end)
    btn.MouseButton1Up:Connect(function() flyDown = false end)
    btn.MouseLeave:Connect(function() flyDown = false end)
end

bindUp(upBtn)
bindDown(downBtn)

local flyDragging = false
local function updateFlySpeed(x)
    local rel = (x - flyBar.AbsolutePosition.X) / flyBar.AbsoluteSize.X
    if rel < 0 then rel = 0 elseif rel > 1 then rel = 1 end
    flyFill.Size = UDim2.new(rel, 0, 1, 0)
    local v = math.floor(10 + (300 - 10) * rel + 0.5)
    Config.FlySpeed = v
    flySpeedLabel.Text = "速度: " .. v
end

flyBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        flyDragging = true
        updateFlySpeed(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if flyDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        updateFlySpeed(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        flyDragging = false
    end
end)

bindDrag(flyTitle,
    function() return flyUI.Position end,
    function(pos, startPos, startVal)
        local d = pos - startPos
        flyUI.Position = UDim2.new(startVal.X.Scale, startVal.X.Offset + d.X,
                                    startVal.Y.Scale, startVal.Y.Offset + d.Y)
    end
)

closeFly.MouseButton1Click:Connect(function()
    setFlyEnabled(false)
    flyUI.Visible = false
end)

flySwitchBtn.MouseButton1Click:Connect(function()
    local cur = (flySwitchBtn.Text == "ON")
    setFlyEnabled(not cur)
end)

