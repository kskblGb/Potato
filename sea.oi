switchPage = function(name)
    clearContent()
    local build = pages[name]
    if build then build() end
end

local function createSideButton(name)
    local wrapper = Instance.new("Frame")
    wrapper.Size = UDim2.new(1, 0, 0, 32)
    wrapper.BackgroundTransparency = 1
    wrapper.ZIndex = 6
    wrapper.Parent = sidebar

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 0, 16)
    bar.Position = UDim2.new(0, 0, 0.5, -8)
    bar.BackgroundColor3 = THEME.ACCENT
    bar.BorderSizePixel = 0
    bar.ZIndex = 8
    bar.Visible = false
    bar.Parent = wrapper

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1, 0)
    bc.Parent = bar

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundColor3 = THEME.SIDEBAR
    b.Text = name
    b.TextColor3 = THEME.SUBTEXT
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.BorderSizePixel = 0
    b.ZIndex = 7
    b.Parent = wrapper

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        switchPage(name)
        for _, o in ipairs(sideButtons) do
            o.btn.BackgroundColor3 = THEME.SIDEBAR
            o.btn.TextColor3 = THEME.SUBTEXT
            o.bar.Visible = false
        end
        b.BackgroundColor3 = THEME.BG
        b.TextColor3 = THEME.TEXT
        bar.Visible = true
    end)
    table.insert(sideButtons, { btn = b, bar = bar })
    return b
end

createSideButton("主页")
createSideButton("玩家")
createSideButton("GB")
createSideButton("飞行")
createSideButton("移速")
createSideButton("跳跃")
createSideButton("旋转")
switchPage("主页")
if sideButtons[1] then
    sideButtons[1].btn.BackgroundColor3 = THEME.BG
    sideButtons[1].btn.TextColor3 = THEME.TEXT
    sideButtons[1].bar.Visible = true
end

bindDrag(topbar,
    function() return window.Position end,
    function(pos, startPos, startVal)
        local d = pos - startPos
        window.Position = UDim2.new(startVal.X.Scale, startVal.X.Offset + d.X,
                                     startVal.Y.Scale, startVal.Y.Offset + d.Y)
    end
)
--========== 最小化标签 ==========
local miniLabel = Instance.new("TextButton")
miniLabel.Size = UDim2.new(0, 106, 0, 32)
miniLabel.Position = UDim2.new(0, 12, 0, 12)
miniLabel.BackgroundColor3 = THEME.BG
miniLabel.Text = "土豆脚本"
miniLabel.TextColor3 = THEME.YELLOW
miniLabel.TextSize = 14
miniLabel.Font = Enum.Font.GothamBold
miniLabel.BorderSizePixel = 0
miniLabel.AutoButtonColor = false
miniLabel.Visible = false
miniLabel.Active = true
miniLabel.ZIndex = 30
miniLabel.Parent = gui

local mlc = Instance.new("UICorner")
mlc.CornerRadius = UDim.new(0, 8)
mlc.Parent = miniLabel

local mls = Instance.new("UIStroke")
mls.Color = THEME.BORDER
mls.Parent = miniLabel

local miniDrag = false
local miniStartPos = nil
local miniStartVal = nil
local miniMoved = false
local miniStartTime = 0

miniLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        miniDrag = true
        miniMoved = false
        miniStartTime = tick()
        miniStartPos = input.Position
        miniStartVal = miniLabel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if miniDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - miniStartPos
        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then miniMoved = true end
        miniLabel.Position = UDim2.new(miniStartVal.X.Scale, miniStartVal.X.Offset + d.X,
                                        miniStartVal.Y.Scale, miniStartVal.Y.Offset + d.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch) and miniDrag then
        miniDrag = false
        if not miniMoved and (tick() - miniStartTime) < 1 then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            local ww = window.Size.X.Offset
            local wh = window.Size.Y.Offset
            window.Position = UDim2.new(0.5, -ww/2, 0.5, -wh/2)
            window.Visible = true
            miniLabel.Visible = false
        end
    end
end)

minBtn.MouseButton1Click:Connect(function()
    window.Visible = false
    miniLabel.Visible = true
end)

--========== 重生处理 ==========
LP.CharacterAdded:Connect(function()
    stopFly()
    stopRotate()
    stopTeleport()
    if invisState.active then restoreInvis() end
    clearAllZombieESP()
    wait(0.6)
    applySpeed()
    applyJump()
    if Config.Fly then startFly() end
    if Config.RotateEnabled then startRotate() end
    if Config.TeleportEnabled then startTeleport() end
end)

print("[土豆脚本 v9.4] 加载完成")