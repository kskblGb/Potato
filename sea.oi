-- 高度标签
local iwHLbl = Instance.new("TextLabel")
iwHLbl.Size = UDim2.new(1, -24, 0, 14)
iwHLbl.Position = UDim2.new(0, 12, 0, 32)
iwHLbl.BackgroundTransparency = 1
iwHLbl.TextColor3 = THEME.TEXT
iwHLbl.TextXAlignment = Enum.TextXAlignment.Left
iwHLbl.Font = Enum.Font.GothamMedium
iwHLbl.TextSize = 11
iwHLbl.Text = "高度: " .. invisState.height
iwHLbl.ZIndex = 21
iwHLbl.Parent = invisWin

-- 高度滑块
local iwHBar = Instance.new("Frame")
iwHBar.Size = UDim2.new(1, -24, 0, 6)
iwHBar.Position = UDim2.new(0, 12, 0, 48)
iwHBar.BackgroundColor3 = THEME.TRACK
iwHBar.BorderSizePixel = 0
iwHBar.Active = true
iwHBar.ZIndex = 21
iwHBar.Parent = invisWin

local iwHbc = Instance.new("UICorner")
iwHbc.CornerRadius = UDim.new(1, 0)
iwHbc.Parent = iwHBar

local iwHFill = Instance.new("Frame")
iwHFill.Size = UDim2.new((invisState.height - 1) / (1000 - 1), 0, 1, 0)
iwHFill.BackgroundColor3 = THEME.ACCENT
iwHFill.BorderSizePixel = 0
iwHFill.ZIndex = 22
iwHFill.Parent = iwHBar

local iwHfc = Instance.new("UICorner")
iwHfc.CornerRadius = UDim.new(1, 0)
iwHfc.Parent = iwHFill

local iwHK = Instance.new("Frame")
iwHK.Size = UDim2.new(0, 10, 0, 10)
iwHK.AnchorPoint = Vector2.new(0.5, 0.5)
iwHK.Position = UDim2.new((invisState.height - 1) / (1000 - 1), 0, 0.5, 0)
iwHK.BackgroundColor3 = Color3.new(1, 1, 1)
iwHK.BorderSizePixel = 0
iwHK.ZIndex = 23
iwHK.Parent = iwHBar

local iwHKc = Instance.new("UICorner")
iwHKc.CornerRadius = UDim.new(1, 0)
iwHKc.Parent = iwHK

local iwHDrag = false
local function iwHUpdate(x)
    local r = (x - iwHBar.AbsolutePosition.X) / iwHBar.AbsoluteSize.X
    if r < 0 then r = 0 elseif r > 1 then r = 1 end
    iwHFill.Size = UDim2.new(r, 0, 1, 0)
    iwHK.Position = UDim2.new(r, 0, 0.5, 0)
    local v = math.floor(1 + 999 * r + 0.5)
    invisState.height = v
    iwHLbl.Text = "高度: " .. v
end

iwHBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        iwHDrag = true
        iwHUpdate(i.Position.X)
    end
end)
UIS.InputChanged:Connect(function(i)
    if iwHDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch) then
        iwHUpdate(i.Position.X)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        iwHDrag = false
    end
end)

-- 启用按钮
