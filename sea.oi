local Config = {
    ESP = false, Team = true,
    Box = false, Dist = false,
    Fly = false, FlySpeed = 50,
    Speed = false, SpeedVal = 30,
    JumpEnabled = false, JumpValue = 50,
    RotateEnabled = false, RotateSpeed = 90,
    TeleportEnabled = false,
    InvisUI = false,
    ZombieESP = false,
    ZombieScanRate = 1,
    BrightScreen = false,
}

local THEME = {
    BG = Color3.fromRGB(24, 24, 28),
    SIDEBAR = Color3.fromRGB(18, 18, 22),
    TOPBAR = Color3.fromRGB(20, 20, 24),
    ACCENT = Color3.fromRGB(74, 158, 255),
    GREEN = Color3.fromRGB(58, 208, 125),
    OFF = Color3.fromRGB(58, 58, 64),
    TRACK = Color3.fromRGB(38, 38, 44),
    TEXT = Color3.fromRGB(230, 230, 235),
    SUBTEXT = Color3.fromRGB(140, 140, 150),
    BORDER = Color3.fromRGB(52, 52, 58),
    YELLOW = Color3.fromRGB(255, 200, 50),
    RED = Color3.fromRGB(255, 60, 60),
}

