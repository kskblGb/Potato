invisSwitchBtn.Parent = invisWin

local iwsc = Instance.new("UICorner")
iwsc.CornerRadius = UDim.new(0, 6)
iwsc.Parent = invisSwitchBtn

invisSwitchBtn.MouseButton1Click:Connect(function()
    if invisState.active then
        restoreInvis()
    else
        activateInvis()
    end
end)

-- 拖动隐身小窗
local iwDrag = false
local iwSP = nil
local iwSV = nil
iwtb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        iwDrag = true
        iwSP = input.Position
        iwSV = invisWin.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if iwDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - iwSP
        invisWin.Position = UDim2.new(iwSV.X.Scale, iwSV.X.Offset + d.X,
                                       iwSV.Y.Scale, iwSV.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        iwDrag = false
    end
end)

iwClose.MouseButton1Click:Connect(function()
    restoreInvis()
    invisWin.Visible = false
    Config.InvisUI = false
end)
