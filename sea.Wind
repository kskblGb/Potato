--========== 海面波光动画 ==========
local waveT = 0
RunService.RenderStepped:Connect(function(dt)
    if not outer.Parent then return end
    waveT = waveT + dt

    local drift = math.sin(waveT * 0.8) * 0.05
    local h1 = 0.62 + drift
    local h2 = 0.72 + drift
    local h3 = 0.60 + drift

    bgGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(h1, 0.7, 0.28)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(h2, 0.65, 0.38)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(h3, 0.7, 0.32)),
    })

    local bdrDrift = math.sin(waveT * 0.8 + 1.5) * 0.05
    local b1 = 0.60 + bdrDrift
    local b2 = 0.75 + bdrDrift
    local b3 = 0.62 + bdrDrift

    local borderSeq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(b1, 0.75, 0.95)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(b2, 0.7, 1)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(b3, 0.75, 0.9)),
    })
    outerGrad.Color = borderSeq

    local offsetX = math.sin(waveT * 0.4) * 0.3
    bgGrad.Offset = Vector2.new(offsetX, 0)
end)

