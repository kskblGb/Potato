-- 最小化浮窗也参与波光动画
RunService.RenderStepped:Connect(function(dt)
    if not miniOuter.Parent then return end
    local bdrDrift = math.sin(waveT * 0.8 + 1.5) * 0.05
    local b1 = 0.60 + bdrDrift
    local b2 = 0.75 + bdrDrift
    local b3 = 0.62 + bdrDrift
    miniOuterGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(b1, 0.75, 0.95)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(b2, 0.7, 1)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(b3, 0.75, 0.9)),
    })
    local h1 = 0.62 + math.sin(waveT * 0.8) * 0.05
    local h2 = 0.72 + math.sin(waveT * 0.8) * 0.05
    local h3 = 0.60 + math.sin(waveT * 0.8) * 0.05
    miniGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(h1, 0.7, 0.28)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(h2, 0.65, 0.38)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(h3, 0.7, 0.32)),
    })
    miniGrad.Offset = Vector2.new(math.sin(waveT * 0.4) * 0.3, 0)
end)

-- 最小化浮窗拖动
local mDrag = false
local mSP = nil
local mSV = nil
local mMoved = false
local mST = 0

miniLabel.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        mDrag = true
        mMoved = false
        mST = tick()
        mSP = i.Position
        mSV = miniOuter.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if mDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - mSP
        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then mMoved = true end
        miniOuter.Position = UDim2.new(mSV.X.Scale, mSV.X.Offset + d.X,
                                        mSV.Y.Scale, mSV.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if (i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch) and mDrag then
        mDrag = false
        if not mMoved and (tick() - mST) < 1 then
            local ww = outer.Size.X.Offset
            local wh = outer.Size.Y.Offset
            outer.Position = UDim2.new(0.5, -ww/2, 0.5, -wh/2)
            outer.Visible = true
            miniOuter.Visible = false
        end
    end
end)

-- 最小化按钮
minBtn.MouseButton1Click:Connect(function()
    outer.Visible = false
    miniOuter.Visible = true
end)
