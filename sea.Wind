--========== 自检日志 ==========
local function selfCheck()
    local issues = {}
    if not outer or not outer.Parent then
        table.insert(issues, "outer 未创建")
    end
    if not window or not window.Parent then
        table.insert(issues, "window 未创建")
    end
    if not content or not content.Parent then
        table.insert(issues, "content 未创建")
    end
    if not sidebar or not sidebar.Parent then
        table.insert(issues, "sidebar 未创建")
    end
    if #sideButtons ~= 8 then
        table.insert(issues, "侧边按钮数量=" .. tostring(#sideButtons) .. " (应为 8)")
    end
    if not miniOuter or not miniOuter.Parent then
        table.insert(issues, "miniOuter 未创建")
    end

    if #issues == 0 then
        print("[土豆脚本 v9.5] 加载完成 ✅ 自检通过")
    else
        print("[土豆脚本 v9.5] 加载完成 ⚠️ 自检发现问题:")
        for _, msg in ipairs(issues) do
            warn("  - " .. msg)
        end
    end
end

selfCheck()
